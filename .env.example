# Public site URL (used for metadata, sitemap and robots)
NEXT_PUBLIC_SITE_URL=https://mithilamakhana.com

# YouTube channel ID (starts with "UC…"). Enables the live embed on /live and the homepage.
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=

# Optional, server-only: YouTube Data API v3 key. Lets /live detect "Live now" and list upcoming streams.
YOUTUBE_API_KEY=

# Optional: webhook that receives bulk enquiries & snack waitlist sign-ups as JSON
# (Zapier, Make, Slack incoming webhook, Google Apps Script, etc.). Without it, submissions are logged.
ENQUIRY_WEBHOOK_URL=
