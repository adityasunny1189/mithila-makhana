# Public site URL (used for metadata, sitemap and the QR code on the pack artwork)
NEXT_PUBLIC_SITE_URL=https://swadupfoods.com

# Optional: webhook that receives Contact Us submissions as JSON
# (Zapier, Make, Slack incoming webhook, Google Apps Script, etc.). Without it, submissions are logged.
ENQUIRY_WEBHOOK_URL=

# Optional: YouTube channel ID ("UC…") to show a live stream from the farms on /journey
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
